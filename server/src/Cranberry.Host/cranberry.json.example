{
  "_comment": "Every key at its shipped default. Delete what you do not override — an absent key, an absent block and an absent file all mean \"the default\". Precedence is defaults < this file < environment, and the legacy CRANBERRY_* name in the table of docs/110-config.md always wins, so every one-word revert still works.",
  "root": {
    "_comment": "where the host reads data and writes logs; positional arguments 1-9 still win over both file and environment",
    "path": "C:\\Aug2017",
    "zone": "LoginZone",
    "seedCharacter": "",
    "dynamicAppearanceSource": "C:\\Z1\\Server\\Data\\dynamicAppearanceFriend.bin"
  },
  "ports": {
    "_comment": "the two UDP listeners: login, then the gateway the login reply advertises",
    "login": 20042,
    "gateway": 20043
  },
  "metrics": {
    "_comment": "opt-in bounded production JSONL; listener work and queue timing, not a simulation tick or client-display measurement",
    "enabled": false,
    "intervalMs": 5000,
    "maxSessions": 16,
    "maxFileMiB": 16,
    "maxFiles": 4,
    "rolling": false,
    "nodeId": "local"
  },
  "queue": {
    "_comment": "public rolling rosters and measured node admission limits; hosted games retain their explicit lifecycle",
    "waitMs": 180000,
    "loadTimeoutMs": 180000,
    "maxPlayers": 150,
    "minPlayers": 2,
    "maxMatches": 2,
    "acceptTimeoutMs": 60000
  },
  "sky": {
    "_comment": "D30: the sky, the frozen clock and the lighting table move together as one named preset",
    "preset": "Aug2017KotkClear"
  },
  "gas": {
    "_comment": "D23: every number here is Cranberry's own design, so it is retuned by restart and never by rebuild",
    "enabled": true,
    "preset": "Aug2017Retail",
    "pacing": "PhaseTable",
    "preMoveRing": "None",
    "scale": 1,
    "damageScale": 1,
    "phases": 10,
    "firstRevealMs": 120000,
    "firstMoveMs": 370000,
    "holdMs": 16000,
    "wallSpeed": 3.866,
    "finalRadiusM": 40,
    "initialRadiusM": 8000,
    "centreX": -250,
    "centreZ": 100,
    "drift": 0.96,
    "driftCone": 120,
    "maxEdge": 40,
    "radiusRoundM": 5,
    "radiusLadder": 1,
    "tickMs": 1000,
    "updateMs": 500,
    "blendMs": 1000,
    "blendMode": "SendPeriod",
    "centrePlan": "PoiDestination",
    "poiExponent": 0.5,
    "playAreaLeadM": 1200,
    "toxicity": 1,
    "toxicityDrain": 1000,
    "hudHealMs": 1000,
    "safezoneHealMs": 15000,
    "banners": 1
  },
  "movement": {
    "_comment": "D54: the owner's own six speeds and eight blend times, retunable without a rebuild",
    "preset": "Aug2017Default",
    "base": 4.1,
    "sprint": 1.4,
    "walk": 0.3,
    "crouch": 0.7,
    "back": 0.75,
    "strafe": 0.75,
    "swim": 0.55,
    "water": 0.8,
    "sprintAccel": 0.35,
    "sprintDecel": 0,
    "fwdAccel": 0.35,
    "backAccel": 0.35,
    "strafeAccel": 0.35
  },
  "descent": {
    "_comment": "D238/D239: the parachute ride - the release is the client's own 850 m KotK.SkySpawn slab, and the landing guard never dismounts a live chute in the air",
    "preset": "ClientSkySpawn850",
    "seconds": 0,
    "rate": 40.4,
    "landingGuard": true
  },
  "drop": {
    "_comment": "D240/D241: where the match drops and what the canopy is dressed in",
