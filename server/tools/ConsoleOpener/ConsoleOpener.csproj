<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cranberry's client-side console opener for the August 2017 H1Z1 KOTK client
    (build 0.0.118.208059, ClientProtocol_1148).  DESIGN-dev-console.md §3, Lane D.

    Deliberately NOT a member of Cranberry.slnx: a process-patching tool has no business in the
    server build (design §3.4).  Build it on its own:

        dotnet build C:\Aug2017\Server\tools\ConsoleOpener

    No package references, no unsafe blocks: everything is plain P/Invoke into kernel32/user32.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ConsoleOpener</AssemblyName>
    <RootNamespace>Cranberry.Tools.ConsoleOpener</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
