; Cranberry repository editor settings.
; Added 2026-09-02 by overhaul lane 0A (OVERHAUL-PLAN 3, Phase 0 lane 0A; S7 5).
;
; Purpose: stop new files being written with CRLF. S7 0.5 found 45 tracked files with CRLF
; in the working copy against the repository's `* text=auto eol=lf` policy in .gitattributes.
; This file does NOT renormalise anything that already exists -- the owner's commit lane does
; that once, with a reviewed `git add --renormalize .`.
;
; RESOLVED 2026-09-02 (D188): .gitattributes wins for shells. It marks `*.ps1` and `*.cmd`
; `text eol=crlf` because Windows shells run them, so those two extensions are deliberately
; ABSENT from this file's LF rules -- an editor that put them on LF would fight git on every
; save. Everything else is LF in both files.

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
end_of_line = lf
indent_style = space
indent_size = 4

[*.md]
end_of_line = lf
trim_trailing_whitespace = false

; *.ps1 and *.cmd: line endings are .gitattributes' (crlf, D188). Indentation only here.
[*.{ps1,cmd}]
indent_style = space
indent_size = 4

[*.py]
end_of_line = lf
indent_style = space
indent_size = 4

[*.json]
end_of_line = lf
indent_style = space
indent_size = 2
